# Скопируй в .env и заполни. Ключ подписи:
#   docker compose run --rm auth-dev cargo run -p auth-server -- jwt-keygen

# Для запуска на хосте (cargo run). В Docker URL переопределяется в docker-compose.yml.
AUTH__POSTGRES__URL=postgres://postgres:postgres@localhost:2134/auth

AUTH__CRYPTO__JWT__SIGNING_KEY=
AUTH__CRYPTO__JWT__KID=
AUTH__CRYPTO__JWT__ISSUER=auth-dev
AUTH__CRYPTO__JWT__AUDIENCE=auth-dev-clients

# Одноразовый секрет первоначальной настройки (POST /setup), минимум 32 символа:
#   openssl rand -base64 32
# Не задан — /setup выключен. После создания первого админа можно удалить.
AUTH__SETUP__TOKEN=
